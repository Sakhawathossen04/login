# Postgres (Neon / Vercel Postgres / Supabase)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# local: http://localhost:3000 | Vercel: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Forgot-password email (resend.com). Empty = reset link prints in terminal (dev)
RESEND_API_KEY=""
MAIL_FROM="YourApp <onboarding@resend.dev>"
